APP_ENV=local
APP_NAME=Smart Merchant
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgresql+psycopg://merchant:replace-with-long-random-password@localhost:5432/smart_merchant
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-long-random-secret-at-least-32-characters
BOOTSTRAP_KEY=replace-with-long-random-bootstrap-key-at-least-32-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
