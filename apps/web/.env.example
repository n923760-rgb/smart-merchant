# Server-only settings. Never prefix these with NEXT_PUBLIC_.
BACKEND_URL=http://localhost:8000
# One deadline for reading request + backend headers + complete backend body.
BFF_TIMEOUT_MS=10000
# Raw UTF-8 bytes; actual streamed bytes are checked even without Content-Length.
BFF_REQUEST_MAX_BYTES=65536
BFF_RESPONSE_MAX_BYTES=1048576
