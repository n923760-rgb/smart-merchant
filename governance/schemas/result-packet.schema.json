{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Result Packet",
  "type": "object",
  "required": [
    "task_id", "task_type", "task_packet_ref", "executor", "execution_environment",
    "repository", "official_branch", "verified_remote_official_head",
    "exact_tested_head", "authorized_actions", "actions_actually_performed",
    "validation", "facts", "inferences", "assumptions", "residual_risks",
    "recommended_next_action"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "task_packet_ref": {"type": "string", "minLength": 1},
    "executor": {"type": "string", "minLength": 1},
    "execution_environment": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "official_branch": {"type": "string", "minLength": 1},
    "verified_remote_official_head": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "exact_tested_head": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "authorized_actions": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]*$"},
      "uniqueItems": true
    },
    "actions_actually_performed": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]*$"},
      "uniqueItems": true
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check", "status", "evidence"],
        "properties": {
          "check": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED", "NOT RUN"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "facts": {"type": "array", "items": {"type": "string"}},
    "inferences": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "recommended_next_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
