{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Governance Profile",
  "type": "object",
  "required": ["project_name","repository","official_branch","master_roadmap","master_baseline_report","engineering_lab_contract","controller","executor","protected_actions","test_strategy","evidence_location","report_location"],
  "properties": {
    "status":{"type":"string"},
    "governance_source":{"type":"string"},
    "project_name":{"type":"string","minLength":1},
    "repository":{"type":"string","minLength":1},
    "repository_url":{"type":["string","null"]},
    "default_branch":{"type":["string","null"]},
    "official_branch":{"type":"string","minLength":1},
    "repository_authority_file":{"type":["string","null"]},
    "project_baseline":{"type":["string","null"]},
    "architecture_guides":{"type":"array","items":{"type":"string"}},
    "subsystem_contracts":{"type":"array","items":{"type":"string"}},
    "master_roadmap":{"type":"string","const":"ENGINEERING/MASTER_ROADMAP.md"},
    "master_baseline_report":{"type":"string","const":"ENGINEERING/REPORTS/MASTER_ENGINEERING_BASELINE_REPORT.md"},
    "ci_system":{"type":["string","null"]},
    "engineering_lab_contract":{"type":"string","minLength":1},
    "execution_environment":{"type":["string","null"]},
    "verified_execution_capabilities":{"type":"array","items":{"type":"string"}},
    "controller":{"type":"string","minLength":1},
    "executor":{"type":"string","minLength":1},
    "protected_actions":{"type":"array","items":{"type":"string"}},
    "test_strategy":{"type":"string","minLength":1},
    "evidence_location":{"type":"string","const":"ENGINEERING/EVIDENCE/"},
    "report_location":{"type":"string","const":"ENGINEERING/REPORTS/"},
    "artifact_location":{"type":["string","null"]},
    "backup_restore_strategy":{"type":["string","null"]},
    "release_model":{"type":["string","null"]},
    "runtime_device_platform_matrix":{"type":"array","items":{"type":"string"}}
  },
  "additionalProperties": true
}
